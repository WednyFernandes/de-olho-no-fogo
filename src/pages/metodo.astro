---
import Base from '../layouts/Base.astro';
import { Content } from '../../docs/metodo-harmonizacao.md';
---
<Base title="Método e validação · De Olho no Fogo" description="Como harmonizamos os focos MODIS e VIIRS de Minas Gerais e como conferimos contra o INPE.">
  <div class="wrap doc">
    <p class="intro">Documento técnico em inglês, para o júri internacional da NASA. A versão em linguagem simples está na <a href="/">página inicial</a>. <a href="/data/serie-harmonizada-mg.csv" download>Baixar a série (CSV)</a>.</p>
    <article class="md"><Content /></article>
  </div>
</Base>

<style>
.doc{max-width:900px;padding-top:40px}
.intro{background:var(--soft);border-radius:16px;padding:16px 20px;color:var(--ink2);font-size:16px}
.md :global(h1){font-size:clamp(32px,4vw,52px);line-height:1.05;font-weight:900;letter-spacing:-.03em;margin:40px 0 20px;text-wrap:balance}
.md :global(h2){font-size:clamp(24px,2.4vw,32px);font-weight:900;letter-spacing:-.02em;margin:56px 0 12px}
.md :global(p),.md :global(li){max-width:72ch}
.md :global(code){font-size:.88em;background:var(--soft);border-radius:6px;padding:2px 6px}
.md :global(pre){background:var(--soft);border-radius:12px;padding:16px 18px;overflow-x:auto}
.md :global(pre code){background:none;padding:0}
.md :global(table){border-collapse:collapse;width:100%;margin:20px 0;font-size:16px;font-variant-numeric:tabular-nums;display:block;overflow-x:auto}
.md :global(th),.md :global(td){text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:top}
.md :global(th){font-size:14px;color:var(--ink3)}
.md :global(strong){font-weight:800}
</style>
