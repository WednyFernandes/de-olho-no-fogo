---
// Casca comum das páginas novas (hoje: /metodo). Tokens iguais aos de src/legacy/landing.html e DESIGN.md.
const { title, description = '' } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/', 'Início'], ['/globo', 'Globo'], ['/calendario', 'Calendário'], ['/metodo', 'Método']];
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style is:global>
:root{--ink:#22262A;--ink2:#4F575E;--ink3:#575F66;--line:#DCE1E5;--line2:#EBEEF1;--soft:#F3F5F7;--card:#FFFFFF;--brand:#E5004B;--brand-ink:#B80040;--brand-tint:#FFE8EF;--pad:clamp(20px,4.4vw,64px)}
*{box-sizing:border-box}
html{scrollbar-color:#C9CFD4 var(--soft)}
body{margin:0;font-family:Figtree,system-ui,sans-serif;color:var(--ink);background:var(--card);font-size:18px;line-height:1.6;-webkit-font-smoothing:antialiased}
::selection{background:var(--brand-tint);color:var(--brand-ink)}
a{color:var(--brand-ink);text-underline-offset:3px}
:focus-visible{outline:3px solid var(--brand);outline-offset:3px;border-radius:8px}
.wrap{max-width:1440px;margin:0 auto;padding:0 var(--pad)}
.nav{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.94);border-bottom:1px solid var(--line2)}
.nav .wrap{display:flex;align-items:center;gap:24px;height:72px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:19px;color:var(--ink);text-decoration:none;margin-right:auto}
.nav nav{display:flex;gap:6px}
.nav nav a{padding:9px 14px;border-radius:999px;font-weight:600;font-size:16px;color:var(--ink2);text-decoration:none}
.nav nav a:hover{background:var(--soft);color:var(--ink)}
.nav nav a[aria-current="page"]{background:var(--brand-tint);color:var(--brand-ink)}
footer{border-top:1px solid var(--line2);margin-top:96px;padding:32px 0 48px;color:var(--ink3);font-size:15px}
@media (max-width:640px){.logo span{display:none}.nav nav a{padding:8px 10px;font-size:15px}}
</style>
</head>
<body>
<header class="nav">
  <div class="wrap">
    <a class="logo" href="/" aria-label="De Olho no Fogo, início">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#E5004B"/><path d="M5 16c3-5 6.6-7.5 11-7.5S24 11 27 16c-3 5-6.6 7.5-11 7.5S8 21 5 16z" fill="#fff"/><circle cx="16" cy="16" r="4.4" fill="#E5004B"/><path d="M16 13.2c1.2 1.1 1.7 2 1.7 2.9a1.7 1.7 0 0 1-3.4 0c0-.9.5-1.8 1.7-2.9z" fill="#FFC02E"/></svg>
      <span>De Olho no Fogo</span>
    </a>
    <nav aria-label="Páginas">
      {links.map(([href, label]) => <a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<main><slot /></main>
<footer><div class="wrap">Space Uai · NASA Space Apps Challenge 2026 · Ouro Preto, MG</div></footer>
</body>
</html>
